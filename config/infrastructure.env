# ra-infrastructure - Centralized Infrastructure Configuration
# This file is the single source of truth for deployment topology.
# Git-tracked. No secrets here - secrets go in .env (git-ignored).
#
# Override any value via environment variable (env var takes precedence).

# ==========================================================================
# CONTAINER NAMES
# ==========================================================================
RA_POSTGRES_CONTAINER=ra_postgres
RA_MYSQL_CONTAINER=ra_mysql
RA_TRAEFIK_CONTAINER=ra_traefik
RA_GATUS_CONTAINER=ra_gatus
RA_DASHBOARD_CONTAINER=ra_dashboard
RA_SNIPEIT_CONTAINER=ra_snipeit
RA_FASTEN_CONTAINER=ra_fasten
RA_EVENTLOG_CONTAINER=ra_eventlog
RA_EVENTLOG_DB_CONTAINER=ra_eventlog_db

# ==========================================================================
# HOST PORTS (host:container)
# ==========================================================================
RA_POSTGRES_PORT=5433
RA_MYSQL_PORT=3307
RA_TRAEFIK_PORT=8070
RA_GATUS_PORT=8085
RA_DASHBOARD_PORT=8088
RA_SNIPEIT_PORT=8083
RA_FASTEN_PORT=9091
RA_EVENTLOG_PORT=8089
RA_EVENTLOG_DB_PORT=5434

# ==========================================================================
# DATABASE SETTINGS (non-secret)
# ==========================================================================
RA_POSTGRES_DB=inventory
RA_POSTGRES_USER=postgres
RA_MYSQL_DB=snipeit
RA_MYSQL_USER=snipeit
RA_EVENTLOG_DB=event_log
RA_EVENTLOG_USER=eventlog

# ==========================================================================
# DOCKER NETWORK
# ==========================================================================
RA_DOCKER_NETWORK=ra_network

# ==========================================================================
# COMPOSE FILE (relative to repo root)
# ==========================================================================
RA_COMPOSE_FILE=docker-compose.yml

# ==========================================================================
# BACKUP PATHS
# ==========================================================================
RA_BACKUP_DIR=C:\ra-infrastructure-local-backup\inventory
RA_MYSQL_BACKUP_DIR=C:\ra-infrastructure-local-backup\mysql
RA_FASTEN_BACKUP_DIR=C:\ra-infrastructure-local-backup\fasten

# ==========================================================================
# DOMAIN
# ==========================================================================
RA_DOMAIN=selfwize.com

# ==========================================================================
# WINDOWS USER (for path resolution)
# ==========================================================================
RA_WINDOWS_USER=ra-local
