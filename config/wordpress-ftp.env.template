# WordPress FTP Backup Configuration
# Copy to wordpress-ftp.env and fill in your values
# DO NOT commit wordpress-ftp.env to version control

# FTP Server Settings
DEPLOY_HOST=your-ftp-host
DEPLOY_PORT=21
DEPLOY_USER=your-ftp-username
DEPLOY_PASSWORD=your-ftp-password

# Site URL (for reference/logging)
SITE_URL=https://your-site.com
