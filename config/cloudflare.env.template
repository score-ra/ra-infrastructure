# Cloudflare Configuration for selfwize.com
# Copy to cloudflare.env and fill in values

# Domain
CLOUDFLARE_DOMAIN=selfwize.com

# API Credentials (from Cloudflare Dashboard > selfwize.com > Overview > API section)
CLOUDFLARE_ZONE_ID=<your-zone-id>
CLOUDFLARE_ACCOUNT_ID=<your-account-id>

# Nameservers (from Cloudflare Dashboard)
CLOUDFLARE_NS1=<your-ns1>.ns.cloudflare.com
CLOUDFLARE_NS2=<your-ns2>.ns.cloudflare.com

# Tunnel Configuration (from: cloudflared tunnel list)
CLOUDFLARE_TUNNEL_NAME=selfwize-dev
CLOUDFLARE_TUNNEL_ID=<your-tunnel-id>

# Subdomains
SUBDOMAIN_STUFF=stuff.selfwize.com
SUBDOMAIN_WELLNESS=wellness.selfwize.com
SUBDOMAIN_APP=app.selfwize.com
SUBDOMAIN_API=api.selfwize.com

# Local Service Ports
PORT_STUFF=3001
PORT_WELLNESS=3002
PORT_APP=3000
PORT_API=8080
